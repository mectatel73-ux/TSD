    function applyDataToUI(data) {
        if (!data) return;
        if (data.date) document.getElementById('reportDate').value = data.date;
        if (data.time) document.getElementById('reportTime').value = data.time;
        if (data.totals) {
            document.getElementById('totalAdmin').value = data.totals.admin || '0';
            document.getElementById('totalStaff').value = data.totals.staff || '0';
            document.getElementById('totalOut').value = data.totals.out || '0';
            document.getElementById('totalBrig').value = data.totals.brig || '0';
        }
        if (data.stations) {
            if (data.stations.sort?.length === SORT_ZONES.length) for (let i = 0; i < SORT_ZONES.length; i++) SORT_ZONES[i] = data.stations.sort[i];
            if (data.stations.load?.length === LOAD_ZONES.length) for (let i = 0; i < LOAD_ZONES.length; i++) LOAD_ZONES[i] = data.stations.load[i];
            if (data.stations.break?.length === BREAK_ZONES.length) for (let i = 0; i < BREAK_ZONES.length; i++) BREAK_ZONES[i] = data.stations.break[i];
            recalcStationsArray(); saveStationsToStorage(); renderTable();
        }
        const sortBst = document.getElementById('bstSort');
        const loadBst = document.getElementById('bstLoad');
        if (sortBst && data.bstSort !== undefined) sortBst.value = data.bstSort || '';
        if (loadBst && data.bstLoad !== undefined) loadBst.value = data.bstLoad || '';
        const rows = document.querySelectorAll('#reportTable tbody tr:not(.total-row)');
        if (data.rows) {
            data.rows.forEach((row, index) => {
                if (rows[index]) {
                    const o = rows[index].querySelector('.input-out');
                    const b = rows[index].querySelector('.input-bak');
                    const s = rows[index].querySelector('.input-sht');
                    if (o) o.value = row.out || '';
                    if (b) b.value = row.bak || '';
                    if (s) s.value = row.sht || '';
                    if (row.companies) setRowCompanies(index, row.companies);
                }
            });
        }
        calculateTotals();
    }

    function createStepperHTML(id, className, defaultValue = '') {
        return `<div class="stepper">
            <button type="button" class="btn-minus" onclick="stepperChange('${id}', -1)">−</button>
            <input type="number" id="${id}" class="${className}" min="0" value="${defaultValue}" placeholder="0" inputmode="none">
            <button type="button" class="btn-plus" onclick="stepperChange('${id}', 1)">+</button>
        </div>`;
    }

    function stepperChange(id, delta) {
        const input = document.getElementById(id);
        if (!input) return;
        let current = parseInt(input.value) || 0;
        let newVal = Math.max(0, current + delta);
        input.value = newVal;
        input.dispatchEvent(new Event('input', { bubbles: true }));
    }

