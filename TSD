<script>
    const BIN_URL = 'https://json.extendsclass.com/bin/8f524bd9e9b0';
    const SYNC_INTERVAL = 30000;

    const DEFAULT_COMPANIES = ["Кадры", "Чередниченко", "Армас", "Мирус", "Виро-Стафф", "Скилла", "Юнитворк", "Эг Стафф"];
    let COMPANIES = JSON.parse(localStorage.getItem('warehouseCompanies')) || [...DEFAULT_COMPANIES];

    const DEFAULT_DIRECTIONS = [
        "Ижевск", "Чебоксары", "Челны", "Киров", "Екатеринбург",
        "Самара", "Самара Возврат", "Уфа", "Ростов", "Ульяновск",
        "Оренбург", "Нижний Новгород", "Пенза", "Саратов", "Дзержинский",
        "Софьино", "Домодедово", "Казань ВП", "ДМД ЕВСЦ"
    ];
    let SHIPMENT_DIRECTIONS = JSON.parse(localStorage.getItem('warehouseDirections')) || [...DEFAULT_DIRECTIONS];

    const SORT_ZONES = [
        "Веер, Ромашка", "Батч", "КГТ", "Сорт ВП", 
        "Перебор хранения", "МК", "Отгрузка МК", 
        "Саппорт СКК", "Наведение порядка", 
        "Перебор оборотной тары", "Прием мерчей"
    ];
    const LOAD_ZONES = ["Отгрузка ЛХ", "Раскатка буфера", "Отгрузка АХ ВП"];
    const BREAK_ZONES = ["Обед (30 мин)", "Перекур (15 мин)"];
    const stations = [...SORT_ZONES, ...LOAD_ZONES, ...BREAK_ZONES];

    let SHIPMENT_DATA = JSON.parse(localStorage.getItem('warehouseShipment')) || {};
    let SHIPMENT_HISTORY = JSON.parse(localStorage.getItem('warehouseShipmentHistory')) || [];
    let SHIPMENT_SORTED = false;

    // ТСД
    let TSD_DATA = JSON.parse(localStorage.getItem('warehouseTsd')) || {};
    let TSD_HISTORY = JSON.parse(localStorage.getItem('warehouseTsdHistory')) || [];
    let TSD_FILTER = 'all';
    let currentIssueTsdMac = null;
    let currentAcceptTsdMac = null;

    let saveTimer = null, syncTimer = null, isSaving = false;
    let serverLoaded = false;
    let hasUnsavedChanges = false;
    let editingDirs = [];

    // ============ УТИЛИТЫ ============
    function normalizeCode(raw) {
        if (!raw) return '';
        let s = String(raw).trim();
        // Убираем префиксы
        s = s.replace(/^WIFI\s*MAC\s*[:\-]?\s*/i, '');
        // Убираем всё, кроме букв и цифр
        return s.replace(/[^A-Za-z0-9]/g, '').toUpperCase();
    }

    function isMacCode(code) {
        // MAC = 12 символов, только hex (A-F, 0-9)
        return /^[A-F0-9]{12}$/.test(code);
    }

    function isLoginCode(code) {
        // Логин содержит дефис или > 12 символов, или не hex
        if (!code || code.length < 3) return false;
        return !isMacCode(code);
    }

    function formatMacShort(mac) {
        if (!mac) return '—';
        if (mac.length <= 8) return mac;
        return '...' + mac.slice(-6);
    }

    function formatTime(ts) {
        if (!ts) return '—';
        const d = new Date(ts);
        return d.toTimeString().slice(0, 5);
    }

    // ============ МЕНЮ ============
    function toggleMenu() {
        document.getElementById('fullscreenMenu').classList.toggle('active');
    }

    function menuGo(screen) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        if (screen === 'report') {
            document.getElementById('tabReport').classList.add('active');
            document.getElementById('pageTitle').textContent = '📋 Распределение людей';
        } else if (screen === 'shipment') {
            document.getElementById('tabShipment').classList.add('active');
            document.getElementById('pageTitle').textContent = '🚚 Отгрузка';
            renderShipment(SHIPMENT_SORTED);
        } else if (screen === 'analytics') {
            document.getElementById('tabAnalytics').classList.add('active');
            document.getElementById('pageTitle').textContent = '📊 Аналитика';
            renderAnalytics();
        } else if (screen === 'tsd') {
            document.getElementById('tabTsd').classList.add('active');
            document.getElementById('pageTitle').textContent = '📟 Учёт ТСД';
            renderTsdSummary();
            renderTsdTable();
            renderTsdHistory();
            setTimeout(() => {
                const inp = document.getElementById('tsdScanInput');
                if (inp) inp.focus();
            }, 100);
        }
        document.querySelectorAll('.menu-item').forEach(el => el.classList.remove('active'));
        const itemId = 'menuItem' + screen.charAt(0).toUpperCase() + screen.slice(1);
        const item = document.getElementById(itemId);
        if (item) item.classList.add('active');
        toggleMenu();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setSyncStatus(status, text) {
        const el = document.getElementById('syncStatus');
        if (!el) return;
        el.className = 'sync-status sync-' + status;
        el.textContent = text;
    }

    function markUnsaved() {
        hasUnsavedChanges = true;
        setSyncStatus('unsaved', '⚠️ Есть несохранённые — нажмите ✅');
        const btn = document.getElementById('confirmBtn');
        if (btn) { btn.classList.remove('saved'); btn.classList.add('unsaved'); }
    }

    function markSaved() {
        hasUnsavedChanges = false;
        setSyncStatus('online', '✅ Все изменения сохранены');
        const btn = document.getElementById('confirmBtn');
        if (btn) { btn.classList.add('saved'); btn.classList.remove('unsaved'); }
    }

    // ============ СЕРВЕР ============
    async function forceRefreshFromServer() {
        if (hasUnsavedChanges) {
            if (!confirm('Есть несохранённые изменения. Они будут потеряны. Продолжить?')) return;
        }
        serverLoaded = false;
        await loadFromServer();
    }

    async function loadFromServer() {
        try {
            setSyncStatus('connecting', '🔄 Загрузка с сервера...');
            const response = await fetch(BIN_URL + '?t=' + Date.now(), { cache: 'no-store' });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const data = await response.json();
            if (data?.current) applyDataToUI(data.current);
            if (data?.companies?.list) {
                COMPANIES = data.companies.list;
                localStorage.setItem('warehouseCompanies', JSON.stringify(COMPANIES));
            }
            if (data?.directions?.list) {
                SHIPMENT_DIRECTIONS = data.directions.list;
                localStorage.setItem('warehouseDirections', JSON.stringify(SHIPMENT_DIRECTIONS));
            }
            if (data?.archive?.archive) localStorage.setItem('warehouseArchive', JSON.stringify(data.archive.archive));
            if (data?.shipment?.data) {
                SHIPMENT_DATA = data.shipment.data;
                localStorage.setItem('warehouseShipment', JSON.stringify(SHIPMENT_DATA));
            }
            if (data?.shipment?.history) {
                SHIPMENT_HISTORY = data.shipment.history;
                localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
            }
            // ТСД
            if (data?.tsd?.data) {
                TSD_DATA = data.tsd.data;
                localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
            }
            if (data?.tsd?.history) {
                TSD_HISTORY = data.tsd.history;
                localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));
            }
            renderShipment(SHIPMENT_SORTED);
            renderTsdSummary();
            renderTsdTable();
            renderTsdHistory();
            serverLoaded = true;
            markSaved();
            saveDataToLocal();
        } catch (err) {
            console.error('Ошибка загрузки:', err);
            setSyncStatus('offline', '📴 Нет связи, работаем локально');
            serverLoaded = true;
            markSaved();
        }
    }

    async function saveToServer() {
        if (isSaving) return;
        isSaving = true;
        setSyncStatus('connecting', '📤 Сохранение на сервер...');
        try {
            const payload = {
                current: collectDataFromUI(),
                companies: { list: COMPANIES },
                directions: { list: SHIPMENT_DIRECTIONS },
                archive: { archive: JSON.parse(localStorage.getItem('warehouseArchive')) || [] },
                shipment: { data: SHIPMENT_DATA, history: SHIPMENT_HISTORY },
                tsd: { data: TSD_DATA, history: TSD_HISTORY }
            };
            payload.current.lastModified = Date.now();
            payload.shipment.lastModified = Date.now();
            payload.tsd.lastModified = Date.now();
            const response = await fetch(BIN_URL, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            markSaved();
        } catch (err) {
            console.error('Ошибка сохранения:', err);
            setSyncStatus('offline', '📴 Ошибка сохранения — попробуйте ещё раз');
        } finally {
            isSaving = false;
        }
    }

    async function confirmSave() {
        if (!serverLoaded) { alert('Подождите, идёт подключение к серверу...'); return; }
        saveDataToLocal();
        await saveToServer();
    }

    function saveDebounced() {
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(() => { saveDataToLocal(); markUnsaved(); }, 300);
    }

    function startSyncLoop() {
        if (syncTimer) clearInterval(syncTimer);
        syncTimer = setInterval(async () => {
            if (isSaving || !serverLoaded || hasUnsavedChanges) return;
            try {
                const response = await fetch(BIN_URL + '?t=' + Date.now(), { cache: 'no-store' });
                if (!response.ok) return;
                const data = await response.json();
                const serverTime = Math.max(
                    data.current?.lastModified || 0, 
                    data.shipment?.lastModified || 0,
                    data.tsd?.lastModified || 0
                );
                const localTime = Math.max(
                    JSON.parse(localStorage.getItem('warehouseReport') || '{}').lastModified || 0,
                    JSON.parse(localStorage.getItem('warehouseShipment') || '{}').lastModified || 0
                );
                if (serverTime > localTime && serverTime > 0) {
                    if (data.current) applyDataToUI(data.current);
                    if (data.companies?.list) {
                        COMPANIES = data.companies.list;
                        localStorage.setItem('warehouseCompanies', JSON.stringify(COMPANIES));
                    }
                    if (data.directions?.list) {
                        SHIPMENT_DIRECTIONS = data.directions.list;
                        localStorage.setItem('warehouseDirections', JSON.stringify(SHIPMENT_DIRECTIONS));
                    }
                    if (data.archive?.archive) {
                        localStorage.setItem('warehouseArchive', JSON.stringify(data.archive.archive));
                        renderAnalytics();
                    }
                    if (data.shipment?.data) {
                        SHIPMENT_DATA = data.shipment.data;
                        localStorage.setItem('warehouseShipment', JSON.stringify(SHIPMENT_DATA));
                    }
                    if (data.shipment?.history) {
                        SHIPMENT_HISTORY = data.shipment.history;
                        localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
                    }
                    if (data.tsd?.data) {
                        TSD_DATA = data.tsd.data;
                        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
                    }
                    if (data.tsd?.history) {
                        TSD_HISTORY = data.tsd.history;
                        localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));
                    }
                    renderShipment(SHIPMENT_SORTED);
                    renderTsdSummary();
                    renderTsdTable();
                    renderTsdHistory();
                    markSaved();
                    saveDataToLocal();
                }
            } catch (err) {}
        }, SYNC_INTERVAL);
    }

    function saveDataToLocal() {
        const data = collectDataFromUI();
        data.lastModified = Date.now();
        localStorage.setItem('warehouseReport', JSON.stringify(data));
        localStorage.setItem('warehouseShipment', JSON.stringify(SHIPMENT_DATA));
        localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
        localStorage.setItem('warehouseDirections', JSON.stringify(SHIPMENT_DIRECTIONS));
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));
        const indicator = document.getElementById('autosaveIndicator');
        if (indicator) {
            const now = new Date();
