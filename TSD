    function getNextTsdNumber() {
        let max = 0;
        Object.values(TSD_DATA).forEach(t => {
            const m = String(t.number || '').match(/ТСД-(\d+)/);
            if (m) max = Math.max(max, parseInt(m[1]) || 0);
