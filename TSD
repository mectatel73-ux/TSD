    function renderTsdTable() {
        const tbody = document.getElementById('tsdTableBody');
        if (!tbody) return;

        const search = (document.getElementById('tsdSearch')?.value || '').toLowerCase().trim();
        let items = Object.keys(TSD_DATA).map(mac => ({ mac, ...TSD_DATA[mac] }));

        // Фильтр по статусу
        if (TSD_FILTER !== 'all') {
            items = items.filter(it => it.status === TSD_FILTER);
        }

        // Поиск
        if (search) {
            items = items.filter(it => 
                (it.number || '').toLowerCase().includes(search) ||
                it.mac.toLowerCase().includes(search) ||
                (it.owner || '').toLowerCase().includes(search)
            );
        }

        // Сортировка: сначала выданные, потом свободные, потом ремонт, потом списанные
        const statusOrder = { issued: 0, free: 1, repair: 2, written: 3 };
        items.sort((a, b) => {
            const s = (statusOrder[a.status] || 9) - (statusOrder[b.status] || 9);
            if (s !== 0) return s;
            return (a.number || '').localeCompare(b.number || '');
        });

        if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-dim); padding:20px;">Ничего не найдено</td></tr>';
            return;
        }

        let html = '';
        items.forEach((it, i) => {
            const statusText = {
                issued: 'Выдан',
                free: 'Свободен',
                repair: 'В ремонте',
                written: 'Списан'
            }[it.status] || '—';

            const rowClass = it.status || '';

            let actions = '';
            if (it.status === 'free') {
                actions = `<button class="tsd-action-btn tsd-action-issue" onclick="openTsdIssueModal('${it.mac}')">📤 Выдать</button>`;
                actions += `<button class="tsd-action-btn tsd-action-repair" onclick="tsdToRepair('${it.mac}')">🔧 В ремонт</button>`;
            } else if (it.status === 'issued') {
                actions = `<button class="tsd-action-btn tsd-action-accept" onclick="openTsdAcceptModal('${it.mac}')">📥 Принять</button>`;
            } else if (it.status === 'repair') {
                actions = `<button class="tsd-action-btn tsd-action-restore" onclick="tsdFromRepair('${it.mac}')">✅ Из ремонта</button>`;
                actions += `<button class="tsd-action-btn tsd-action-writeoff" onclick="tsdWriteOff('${it.mac}')">❌ Списать</button>`;
            } else if (it.status === 'written') {
                actions = `<button class="tsd-action-btn tsd-action-restore" onclick="tsdFromRepair('${it.mac}')">↩️ Вернуть</button>`;
            }

            html += `<tr class="tsd-row ${rowClass}">
                <td>${i + 1}</td>
                <td class="num-cell">${it.number || '—'}</td>
                <td class="mac-cell">${it.mac}</td>
                <td><span class="tsd-status ${it.status}">${statusText}</span></td>
                <td class="owner-cell">${it.owner || '—'}</td>
                <td>${formatTime(it.issuedAt)}</td>
                <td class="actions-cell">${actions}</td>
            </tr>`;
        });
        tbody.innerHTML = html;
    }

    function renderTsdHistory() {
        const container = document.getElementById('tsdHistoryList');
        if (!container) return;
        const dayAgo = Date.now() - 24 * 60 * 60 * 1000;
        TSD_HISTORY = TSD_HISTORY.filter(h => h.time >= dayAgo);
        localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));

        if (TSD_HISTORY.length === 0) {
            container.innerHTML = '<div style="color: var(--text-dim); font-size: 12px;">История пуста</div>';
            return;
        }

        let html = '';
        TSD_HISTORY.slice(0, 100).forEach(h => {
            const t = new Date(h.time).toTimeString().slice(0,5);
            let text = '';
            if (h.action === 'issue') text = `📤 Выдан ${h.number} → ${h.owner}`;
            else if (h.action === 'accept') text = `📥 Принят ${h.number} от ${h.owner}`;
            else if (h.action === 'repair') text = `🔧 ${h.number} → В ремонт`;
            else if (h.action === 'restore') text = `✅ ${h.number} → Из ремонта`;
            else if (h.action === 'writeoff') text = `❌ ${h.number} → Списан`;
            html += `<div class="history-item">
                <span class="h-time">${t}</span>
                <span class="h-text">${text}</span>
            </div>`;
        });
        container.innerHTML = html;
    }

    function addTsdHistory(action, number, owner, mac) {
        TSD_HISTORY.unshift({
            time: Date.now(),
            action,
            number,
            owner: owner || '',
            mac: mac || ''
        });
        if (TSD_HISTORY.length > 500) TSD_HISTORY = TSD_HISTORY.slice(0, 500);
        localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));
    }

    function handleTsdScan(code) {
        if (!code) return;
        const norm = normalizeCode(code);

        if (isMacCode(norm)) {
            // Это MAC - ТСД
            handleTsdMacScan(norm);
        } else if (isLoginCode(norm)) {
            // Это логин - сотрудник
            handleLoginScan(norm);
        } else {
            alert('Не могу распознать код: ' + code);
        }
    }

    function handleTsdMacScan(mac) {
        // Ищем ТСД
        if (!TSD_DATA[mac]) {
            // Новый ТСД - создаём
            TSD_DATA[mac] = {
                number: getNextTsdNumber(),
                status: 'free',
                owner: null,
                issuedAt: null,
                createdAt: Date.now()
            };
            localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
            addTsdHistory('created', TSD_DATA[mac].number, null, mac);
            saveDebounced();
        }

        const tsd = TSD_DATA[mac];

        if (tsd.status === 'free') {
            // Открываем окно выдачи
            openTsdIssueModal(mac);
        } else if (tsd.status === 'issued') {
            // Открываем окно приёма
            openTsdAcceptModal(mac);
        } else if (tsd.status === 'repair') {
            if (confirm(`ТСД ${tsd.number} в ремонте. Вернуть в работу?`)) {
                tsdFromRepair(mac);
            }
        } else if (tsd.status === 'written') {
            alert(`ТСД ${tsd.number} списан.`);
        }
    }

    function handleLoginScan(login) {
        // Если окно выдачи открыто - заполняем логин
        const issueModal = document.getElementById('tsdIssueModal');
        if (issueModal.classList.contains('active')) {
            document.getElementById('issueLoginInput').value = login;
            return;
        }
        // Иначе - просто сообщение
        alert(`Логин сотрудника: ${login}\n\nОтсканируй ТСД первым, чтобы выдать или принять.`);
    }

    function openTsdIssueModal(mac) {
        const tsd = TSD_DATA[mac];
        if (!tsd) return;
        currentIssueTsdMac = mac;
        document.getElementById('issueTsdNum').textContent = tsd.number;
        document.getElementById('issueTsdMac').textContent = mac;
        document.getElementById('issueLoginInput').value = '';
        document.getElementById('tsdIssueModal').classList.add('active');
        setTimeout(() => document.getElementById('issueLoginInput').focus(), 100);
    }

    function closeTsdIssueModal() {
        document.getElementById('tsdIssueModal').classList.remove('active');
        currentIssueTsdMac = null;
        setTimeout(() => document.getElementById('tsdScanInput')?.focus(), 100);
    }

    function confirmTsdIssue() {
        if (!currentIssueTsdMac) return;
        const login = document.getElementById('issueLoginInput').value.trim();
        if (!login) { alert('Отсканируй логин сотрудника'); return; }

        const tsd = TSD_DATA[currentIssueTsdMac];
        if (!tsd) return;

        tsd.status = 'issued';
        tsd.owner = login;
        tsd.issuedAt = Date.now();
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        addTsdHistory('issue', tsd.number, login, currentIssueTsdMac);
        saveDebounced();

        closeTsdIssueModal();
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
    }

    function openTsdAcceptModal(mac) {
        const tsd = TSD_DATA[mac];
        if (!tsd) return;
        currentAcceptTsdMac = mac;
        document.getElementById('acceptTsdNum').textContent = tsd.number;
        document.getElementById('acceptTsdMac').textContent = mac;
        document.getElementById('acceptTsdOwner').textContent = tsd.owner || '—';
        document.getElementById('acceptTsdTime').textContent = formatTime(tsd.issuedAt);
        document.getElementById('tsdAcceptModal').classList.add('active');
    }

    function closeTsdAcceptModal() {
        document.getElementById('tsdAcceptModal').classList.remove('active');
        currentAcceptTsdMac = null;
        setTimeout(() => document.getElementById('tsdScanInput')?.focus(), 100);
    }

    function confirmTsdAccept() {
        if (!currentAcceptTsdMac) return;
        const tsd = TSD_DATA[currentAcceptTsdMac];
        if (!tsd) return;

        const oldOwner = tsd.owner;
        tsd.status = 'free';
        tsd.owner = null;
        tsd.issuedAt = null;
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        addTsdHistory('accept', tsd.number, oldOwner, currentAcceptTsdMac);
        saveDebounced();

        closeTsdAcceptModal();
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
    }

    function tsdToRepair(mac) {
        const tsd = TSD_DATA[mac];
        if (!tsd) return;
        if (!confirm(`Отправить ${tsd.number} в ремонт?`)) return;
        tsd.status = 'repair';
        tsd.owner = null;
        tsd.issuedAt = null;
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        addTsdHistory('repair', tsd.number, null, mac);
        saveDebounced();
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
    }

    function tsdFromRepair(mac) {
        const tsd = TSD_DATA[mac];
        if (!tsd) return;
        tsd.status = 'free';
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        addTsdHistory('restore', tsd.number, null, mac);
        saveDebounced();
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
    }

    function tsdWriteOff(mac) {
        const tsd = TSD_DATA[mac];
        if (!tsd) return;
        if (!confirm(`Списать ${tsd.number} навсегда?`)) return;
        tsd.status = 'written';
        localStorage.setItem('warehouseTsd', JSON.stringify(TSD_DATA));
        addTsdHistory('writeoff', tsd.number, null, mac);
        saveDebounced();
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
    }

    function clearTsdHistory() {
        if (!confirm('Очистить всю историю ТСД?')) return;
        TSD_HISTORY = [];
        localStorage.setItem('warehouseTsdHistory', JSON.stringify(TSD_HISTORY));
        renderTsdHistory();
        saveDebounced();
    }

    // ============ ЗАГРУЗКА ============
    window.addEventListener('load', async function() {
        const now = new Date();
        document.getElementById('reportDate').value = now.toISOString().split('T')[0];
        document.getElementById('reportTime').value = now.toTimeString().slice(0,5);

        document.querySelectorAll('.rec-item .stepper-container').forEach(container => {
            const targetId = container.dataset.target;
            container.outerHTML = createStepperHTML(targetId, 'rec-input');
        });
        loadStationsFromStorage();
        renderTable();
        document.querySelectorAll('input[type="number"]').forEach(input => {
            input.addEventListener('input', () => { calculateTotals(); saveDebounced(); });
        });
        document.getElementById('reportDate').addEventListener('change', saveDebounced);
        document.getElementById('reportTime').addEventListener('change', saveDebounced);

        const savedZoom = parseInt(localStorage.getItem('warehouseZoom'));
        if (savedZoom && savedZoom >= ZOOM_MIN && savedZoom <= ZOOM_MAX) currentZoom = savedZoom;

        loadFromLocal();
        calculateTotals();
        renderAnalytics();
        renderShipment(false);
        renderTsdSummary();
        renderTsdTable();
        renderTsdHistory();
        setTimeout(applyZoom, 100);

        // Сканер ТСД - поле ввода
        const scanInput = document.getElementById('tsdScanInput');
        if (scanInput) {
            scanInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const code = scanInput.value.trim();
                    scanInput.value = '';
                    if (code) handleTsdScan(code);
                }
            });
        }

        await loadFromServer();
        startSyncLoop();
    });

    window.addEventListener('resize', () => { applyZoom(); });

    function renderTable() {
        const tbody = document.querySelector('#reportTable tbody');
        tbody.innerHTML = '';
        const loadStart = SORT_ZONES.length;
        const loadEnd = loadStart + LOAD_ZONES.length - 1;
        const breakStart = loadEnd + 1;

        stations.forEach((station, idx) => {
            const tr = document.createElement('tr');
            let zoneClass = 'zone-sort';
            if (idx >= loadStart && idx <= loadEnd) zoneClass = 'zone-load';
            if (idx >= breakStart) zoneClass = 'zone-break';
            tr.className = zoneClass;

            const outId = `out_${idx}`, bakId = `bak_${idx}`, shtId = `sht_${idx}`;
            tr.innerHTML = `
                <td class="station-name" data-station-idx="${idx}" onclick="editStationName(${idx})">${station}</td>
                <td>${createStepperHTML(outId, 'input-out')}</td>
                <td>${createStepperHTML(bakId, 'input-bak')}</td>
                <td class="companies-cell">
                    <div class="companies-list" data-row="${idx}">
                        <button type="button" class="add-company-btn" onclick="openCompanyModal(${idx})">+ Добавить</button>
                    </div>
                </td>
                <td>${createStepperHTML(shtId, 'input-sht')}</td>
            `;
            if (idx === 0) {
                const td = document.createElement('td');
                td.rowSpan = SORT_ZONES.length;
                td.className = 'brig-cell sort';
                td.innerHTML = createStepperHTML('bstSort', 'input-bst-sort');
                tr.appendChild(td);
            }
            if (idx === loadStart) {
                const td = document.createElement('td');
                td.rowSpan = LOAD_ZONES.length;
                td.className = 'brig-cell load';
                td.innerHTML = createStepperHTML('bstLoad', 'input-bst-load');
                tr.appendChild(td);
            }
            if (idx >= breakStart) {
                const td = document.createElement('td');
                td.textContent = '—';
                td.style.background = '#1a1d21';
                td.style.color = '#6c757d';
                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        });

        const totalTr = document.createElement('tr');
        totalTr.className = 'total-row';
        totalTr.innerHTML = `
            <td style="text-align: right; padding-right: 10px;">ИТОГ:</td>
            <td id="total-out">0</td>
            <td id="total-bak">0</td>
            <td></td>
            <td id="total-sht">0</td>
            <td id="total-bst">0</td>
        `;
        tbody.appendChild(totalTr);
    }

    function calculateTotals() {
        let out = 0, bak = 0, sht = 0;
        document.querySelectorAll('#reportTable tbody tr:not(.total-row)').forEach(tr => {
            out += Number(tr.querySelector('.input-out')?.value) || 0;
            bak += Number(tr.querySelector('.input-bak')?.value) || 0;
            sht += Number(tr.querySelector('.input-sht')?.value) || 0;
        });
        const bst = (Number(document.getElementById('bstSort')?.value) || 0) + (Number(document.getElementById('bstLoad')?.value) || 0);
        document.getElementById('total-out').textContent = out;
        document.getElementById('total-bak').textContent = bak;
        document.getElementById('total-sht').textContent = sht;
        document.getElementById('total-bst').textContent = bst;

        const totalAdmin = Number(document.getElementById('totalAdmin').value) || 0;
        const totalStaff = Number(document.getElementById('totalStaff').value) || 0;
        const totalOut = Number(document.getElementById('totalOut').value) || 0;
        const totalBrig = Number(document.getElementById('totalBrig').value) || 0;
        document.getElementById('grandTotal').textContent = totalAdmin + totalStaff + totalOut + totalBrig + bst;

        const declaredTotal = totalStaff + totalOut + totalBrig;
        const actualTotal = out + sht + bak;
        const diff = declaredTotal - actualTotal;
        const statusDiv = document.getElementById('recStatus');

        if (declaredTotal === 0 && actualTotal === 0) {
            statusDiv.innerHTML = "Введите данные для сверки...";
            statusDiv.className = "rec-status status-neutral";
        } else if (diff === 0) {
            statusDiv.innerHTML = `✅ <b>Всё сходится!</b><br><span class="details">На смене: <b>${declaredTotal}</b> | Распределено: <b>${actualTotal}</b></span>`;
            statusDiv.className = "rec-status status-ok";
        } else {
            statusDiv.innerHTML = `⚠️ <b>РАСХОЖДЕНИЕ! Разница: ${diff > 0 ? '+' : ''}${diff}</b><br><span class="details">На смене: <b>${declaredTotal}</b> | Распределено: <b>${actualTotal}</b></span>`;
            statusDiv.className = "rec-status status-error";
        }
        renderAnalytics();
    }

    function renderAnalytics() {
        const archive = JSON.parse(localStorage.getItem('warehouseArchive')) || [];
        renderHistory(archive);
        renderTopZones();
        renderCompare(archive);
        renderArchive(archive);
    }

    function renderHistory(archive) {
        const container = document.getElementById('historyTableContainer');
        if (!container) return;
        if (archive.length === 0) { container.innerHTML = '<p style="color: var(--text-dim); font-size: 12px;">Нет отчетов.</p>'; return; }
        const last7 = archive.slice(0, 7);
        let html = '<table class="history-table"><thead><tr><th>Дата</th><th>Время</th><th>На смене</th><th>Распр.</th><th>Расх.</th></tr></thead><tbody>';
        last7.forEach(r => {
            const diffClass = r.diff === 0 ? 'diff-zero' : (r.diff > 0 ? 'diff-positive' : 'diff-negative');
            const diffText = r.diff === 0 ? '0' : (r.diff > 0 ? '+' + r.diff : r.diff);
            html += `<tr><td>${r.date}</td><td>${r.time}</td><td>${r.declaredTotal}</td><td>${r.actualTotal}</td><td class="${diffClass}">${diffText}</td></tr>`;
        });
        html += '</tbody></table>';
        container.innerHTML = html;
    }

    function renderTopZones() {
        const container = document.getElementById('topZonesList');
        if (!container) return;
        const zones = [];
        document.querySelectorAll('#reportTable tbody tr:not(.total-row)').forEach((tr) => {
            const station = tr.querySelector('.station-name').textContent;
            const out = Number(tr.querySelector('.input-out')?.value) || 0;
            const bak = Number(tr.querySelector('.input-bak')?.value) || 0;
            const sht = Number(tr.querySelector('.input-sht')?.value) || 0;
            const total = out + bak + sht;
            if (total > 0) zones.push({ station, total });
        });
        if (zones.length === 0) { container.innerHTML = '<li style="color: var(--text-dim); font-size: 12px;">Нет данных.</li>'; return; }
        zones.sort((a, b) => b.total - a.total);
        const top5 = zones.slice(0, 5);
        const maxLoad = top5[0].total;
        let html = '';
        top5.forEach((z, i) => {
            const barWidth = Math.round((z.total / maxLoad) * 100);
            html += `<li><span class="zone-name">${i + 1}. ${z.station}</span><span><span class="zone-bar" style="width: ${barWidth}px; max-width: 80px;"></span> <b>${z.total}</b></span></li>`;
        });
        container.innerHTML = html;
    }

    function renderCompare(archive) {
        const container = document.getElementById('compareContainer');
        if (!container) return;
        if (archive.length < 2) { container.innerHTML = '<p style="color: var(--text-dim); font-size: 12px;">Нужно минимум 2 отчета.</p>'; return; }
        const current = archive[0], previous = archive[1];
        const formatDiff = (d) => d === 0 ? '<span class="diff-zero">0</span>' : (d > 0 ? `<span class="diff-positive">+${d}</span>` : `<span class="diff-negative">${d}</span>`);
        container.innerHTML = `
            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 6px;">Сравнение с <b>${previous.date} ${previous.time}</b></div>
            <div class="compare-item"><span>На смене:</span> <span>${previous.declaredTotal} → ${current.declaredTotal} ${formatDiff(current.declaredTotal - previous.declaredTotal)}</span></div>
            <div class="compare-item"><span>Распределено:</span> <span>${previous.actualTotal} → ${current.actualTotal} ${formatDiff(current.actualTotal - previous.actualTotal)}</span></div>
            <div class="compare-item"><span>Бриг. Стаф:</span> <span>${previous.bst} → ${current.bst} ${formatDiff(current.bst - previous.bst)}</span></div>
        `;
    }

    function renderArchive(archive) {
        const container = document.getElementById('archiveContainer');
        if (!container) return;
        document.getElementById('archiveCount').textContent = archive.length;
        if (archive.length === 0) { container.innerHTML = '<p style="color: var(--text-dim); font-size: 12px;">Архив пуст.</p>'; return; }
        let html = '';
        archive.slice(0, 10).forEach(r => {
            const diffText = r.diff === 0 ? '✅' : (r.diff > 0 ? '⚠️ +' + r.diff : '⚠️ ' + r.diff);
            html += `<div class="archive-item">
                <span><b>${r.date} ${r.time}</b> — ${r.declaredTotal} чел. ${diffText}</span>
                <button onclick="loadFromArchive(${r.id})">Загрузить</button>
            </div>`;
        });
        container.innerHTML = html;
    }

    function loadFromArchive(id) {
        const archive = JSON.parse(localStorage.getItem('warehouseArchive')) || [];
        const report = archive.find(r => r.id === id);
        if (!report) return;
        if (!confirm(`Загрузить отчет от ${report.date} ${report.time}?`)) return;
        document.getElementById('reportDate').value = report.date;
        document.getElementById('reportTime').value = report.time;
        document.getElementById('totalAdmin').value = report.admin;
        document.getElementById('totalStaff').value = report.staff;
        document.getElementById('totalOut').value = report.out;
        document.getElementById('totalBrig').value = report.brig;
        if (document.getElementById('bstSort')) document.getElementById('bstSort').value = report.bst;
        if (document.getElementById('bstLoad')) document.getElementById('bstLoad').value = 0;
        const rows = document.querySelectorAll('#reportTable tbody tr:not(.total-row)');
        report.rows.forEach((row, index) => {
            if (rows[index]) {
                const o = rows[index].querySelector('.input-out');
                const b = rows[index].querySelector('.input-bak');
                const s = rows[index].querySelector('.input-sht');
                if (o) o.value = row.out || 0;
                if (b) b.value = row.bak || 0;
                if (s) s.value = row.sht || 0;
                if (row.companies) setRowCompanies(index, row.companies);
            }
        });
        calculateTotals(); saveDebounced();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        alert('✅ Отчет загружен!');
    }

    function clearArchive() {
        if (!confirm('Удалить весь архив?')) return;
        localStorage.removeItem('warehouseArchive');
        renderAnalytics(); saveDebounced();
    }

    function clearData() {
        if(confirm('Очистить все поля? Это удалит все данные из таблицы и сверху.')) {
            document.querySelectorAll('input[type="number"]').forEach(input => { input.value = ''; });
            document.getElementById('totalAdmin').value = '0';
            document.getElementById('totalStaff').value = '0';
            document.getElementById('totalOut').value = '0';
            document.getElementById('totalBrig').value = '0';
            document.querySelectorAll('.companies-list').forEach(list => {
                list.querySelectorAll('.company-chip').forEach(c => c.remove());
            });
            localStorage.removeItem('warehouseReport');
            calculateTotals();
            document.getElementById('autosaveIndicator').textContent = '🧹 Очищено';
            setTimeout(() => { document.getElementById('autosaveIndicator').textContent = ''; }, 2000);
            saveDebounced();
        }
    }

    let deferredPrompt = null;
    const installBtn = document.getElementById('installBtn');
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault(); deferredPrompt = e; installBtn.style.display = 'block';
    });
    function installPWA() {
        if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(() => { deferredPrompt = null; installBtn.style.display = 'none'; });
        }
    }
    window.addEventListener('appinstalled', () => { installBtn.style.display = 'none'; });

    function exportCSV() {
        let csv = 'Рабочая станция;Аутстафф;Бригадир АК;АК Компания;Штат;Бригадир Стаф\n';
        const sortBst = document.getElementById('bstSort')?.value || '';
        const loadBst = document.getElementById('bstLoad')?.value || '';
        document.querySelectorAll('#reportTable tbody tr:not(.total-row)').forEach((tr, idx) => {
            const station = tr.querySelector('.station-name').textContent;
            const out = tr.querySelector('.input-out')?.value || '';
            const bak = tr.querySelector('.input-bak')?.value || '';
            const companies = getRowCompanies(idx).join(', ');
            const sht = tr.querySelector('.input-sht')?.value || '';
            let bst = '';
            if (idx === 0) bst = sortBst;
            if (idx === SORT_ZONES.length) bst = loadBst;
            csv += `${station};${out};${bak};${companies};${sht};${bst}\n`;
        });
        csv += '\n--- СВЕРКА ---\n';
        csv += `Админка;${document.getElementById('totalAdmin').value}\n`;
        csv += `Штатные;${document.getElementById('totalStaff').value}\n`;
        csv += `Аутстафф;${document.getElementById('totalOut').value}\n`;
        csv += `Бригадиры АК;${document.getElementById('totalBrig').value}\n`;
        csv += `Бриг. Стаф Сорт;${sortBst}\n`;
        csv += `Бриг. Стаф Отгр;${loadBst}\n`;

        csv += '\n--- ОТГРУЗКА ---\n';
        csv += 'Направление;Габарит;Негабарит;Тотал;Потр ТС;Есть ТС;X-dok;ВП\n';
        SHIPMENT_DIRECTIONS.forEach(dir => {
            const d = SHIPMENT_DATA[dir] || {};
            const gab = Number(d.gab) || 0;
            const negab = Number(d.negab) || 0;
            const sum = gab + negab;
            csv += `${dir};${gab};${negab};${sum};${d.needTS || 0};${d.haveTS || 0};${d.xdok || 0};${d.vp || 0}\n`;
        });

        csv += '\n--- ТСД ---\n';
        csv += 'Номер;MAC;Статус;У кого;Выдан\n';
        Object.keys(TSD_DATA).forEach(mac => {
            const t = TSD_DATA[mac];
            const statusText = { issued: 'Выдан', free: 'Свободен', repair: 'В ремонте', written: 'Списан' }[t.status] || '—';
            csv += `${t.number || '—'};${mac};${statusText};${t.owner || '—'};${t.issuedAt ? formatTime(t.issuedAt) : '—'}\n`;
        });

        const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.setAttribute('href', URL.createObjectURL(blob));
        link.setAttribute('download', `Отчет_склад_${document.getElementById('reportDate').value}.csv`);
        link.click();
    }
