    let currentZoom = 100;
    const ZOOM_STEP = 10, ZOOM_MIN = 50, ZOOM_MAX = 130;

    function applyZoom() {
        const table = document.querySelector('#reportTable');
        const wrap = document.getElementById('tableWrap');
        if (!table || !wrap) return;
        const scale = currentZoom / 100;
        table.style.transform = `scale(${scale})`;
        table.style.transformOrigin = 'top left';
        table.style.width = (100 / scale) + '%';
        wrap.style.height = '';
        document.getElementById('zoomValue').textContent = currentZoom + '%';
        localStorage.setItem('warehouseZoom', currentZoom);
    }

    function changeZoom(delta) {
        currentZoom = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, currentZoom + delta * ZOOM_STEP));
        applyZoom();
    }

    function resetZoom() { currentZoom = 100; applyZoom(); }

    function recalcStationsArray() {
        stations.length = 0;
        stations.push(...SORT_ZONES, ...LOAD_ZONES, ...BREAK_ZONES);
    }

    function saveStationsToStorage() {
        localStorage.setItem('warehouseStations', JSON.stringify({ sort: SORT_ZONES, load: LOAD_ZONES, break: BREAK_ZONES }));
    }

    function loadStationsFromStorage() {
        try {
            const saved = JSON.parse(localStorage.getItem('warehouseStations'));
            if (saved) {
                if (saved.sort?.length === SORT_ZONES.length) for (let i = 0; i < SORT_ZONES.length; i++) SORT_ZONES[i] = saved.sort[i];
                if (saved.load?.length === LOAD_ZONES.length) for (let i = 0; i < LOAD_ZONES.length; i++) LOAD_ZONES[i] = saved.load[i];
                if (saved.break?.length === BREAK_ZONES.length) for (let i = 0; i < BREAK_ZONES.length; i++) BREAK_ZONES[i] = saved.break[i];
                recalcStationsArray();
            }
