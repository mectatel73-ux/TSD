    function editStationName(idx) {
        const td = document.querySelector(`.station-name[data-station-idx="${idx}"]`);
        if (!td || td.classList.contains('editing')) return;
        const oldName = stations[idx];
        td.classList.add('editing');
        td.innerHTML = `<input type="text" value="${oldName}" maxlength="40">`;
        const input = td.querySelector('input');
        input.focus(); input.select();
        const finish = (save) => {
            const newName = input.value.trim();
            td.classList.remove('editing');
            if (save && newName && newName !== oldName) {
                stations[idx] = newName;
                if (idx < SORT_ZONES.length) SORT_ZONES[idx] = newName;
                else if (idx < SORT_ZONES.length + LOAD_ZONES.length) LOAD_ZONES[idx - SORT_ZONES.length] = newName;
                else BREAK_ZONES[idx - SORT_ZONES.length - LOAD_ZONES.length] = newName;
                saveStationsToStorage(); recalcStationsArray(); saveDebounced();
            }
            renderTable();
            loadFromLocal();
        };
        input.addEventListener('blur', () => finish(true));
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            if (e.key === 'Escape') { e.preventDefault(); finish(false); }
        });
    }

    function renderShipment(sort) {
        if (typeof sort === 'undefined') sort = SHIPMENT_SORTED;
        else SHIPMENT_SORTED = sort;

        const directions = SHIPMENT_DIRECTIONS.map(dir => {
            const d = SHIPMENT_DATA[dir] || { gab: 0, negab: 0, ts: 0, needTS: 0, haveTS: 0, xdok: 0, vp: 0 };
            return {
                name: dir,
                gab: Number(d.gab) || 0,
                negab: Number(d.negab) || 0,
                ts: Number(d.ts) || 0,
                needTS: Number(d.needTS) || 0,
                haveTS: Number(d.haveTS) || 0,
                xdok: Number(d.xdok) || 0,
                vp: Number(d.vp) || 0,
                sum: (Number(d.gab) || 0) + (Number(d.negab) || 0)
            };
        });

        if (sort) directions.sort((a, b) => b.sum - a.sum);

        const topList = document.getElementById('shipmentTopList');
        const sortedForTop = [...directions].sort((a, b) => b.sum - a.sum);
        const top3 = sortedForTop.filter(d => d.sum > 0).slice(0, 3);
        if (top3.length === 0) {
            topList.innerHTML = '<div style="text-align: center; color: var(--text-dim); font-size: 13px;">Нет данных</div>';
        } else {
            topList.innerHTML = top3.map((d, i) => `
                <div class="shipment-top-item rank-${i+1}">
                    <div class="rank-dir">
                        ${i+1}. ${d.name}
                        <div class="rank-details">Габарит: ${d.gab} | Негабарит: ${d.negab} | Тотал: ${d.sum}</div>
                    </div>
                    <div class="rank-sum">${d.sum}</div>
                </div>
            `).join('');
        }

        const tbody = document.querySelector('#shipmentTable tbody');
        tbody.innerHTML = '';
        directions.forEach((d, i) => {
            const tr = document.createElement('tr');
            if (sort) {
                if (i === 0 && d.sum > 0) tr.className = 'rank-1';
                else if (i === 1 && d.sum > 0) tr.className = 'rank-2';
                else if (i === 2 && d.sum > 0) tr.className = 'rank-3';
            }
            const safeName = d.name.replace(/'/g, "\\'");
            tr.innerHTML = `
                <td class="dir-name">${d.name}</td>
                <td>${shipStepHTML(safeName, 'gab', d.gab)}</td>
                <td>${shipStepHTML(safeName, 'negab', d.negab)}</td>
                <td class="sum-cell">${d.sum}</td>
                <td class="ts-cell">${shipStepHTML(safeName, 'needTS', d.needTS)}</td>
                <td>${shipStepHTML(safeName, 'haveTS', d.haveTS)}</td>
                <td>${shipStepHTML(safeName, 'xdok', d.xdok)}</td>
                <td>${shipStepHTML(safeName, 'vp', d.vp)}</td>
            `;
            tbody.appendChild(tr);
        });
        renderShipmentHistory();
    }

    function shipStepHTML(dir, field, value) {
        return `<div class="stepper ship-stepper">
            <button type="button" class="btn-minus" onclick="shipStep('${dir}', '${field}', -1)">−</button>
            <input type="number" value="${value}" min="0" inputmode="none" readonly>
            <button type="button" class="btn-plus" onclick="shipStep('${dir}', '${field}', 1)">+</button>
        </div>`;
    }

    function shipStep(dir, field, delta) {
        if (!SHIPMENT_DATA[dir]) SHIPMENT_DATA[dir] = { gab: 0, negab: 0, ts: 0, needTS: 0, haveTS: 0, xdok: 0, vp: 0 };
        const newVal = Math.max(0, (SHIPMENT_DATA[dir][field] || 0) + delta);
        if (newVal === SHIPMENT_DATA[dir][field]) return;
        SHIPMENT_DATA[dir][field] = newVal;
        if (delta > 0 && (field === 'gab' || field === 'negab' || field === 'ts')) {
            const entry = { time: Date.now(), direction: dir, gab: 0, negab: 0, ts: 0 };
            entry[field] = delta;
            SHIPMENT_HISTORY.unshift(entry);
            if (SHIPMENT_HISTORY.length > 200) SHIPMENT_HISTORY = SHIPMENT_HISTORY.slice(0, 200);
            localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
        }
        localStorage.setItem('warehouseShipment', JSON.stringify(SHIPMENT_DATA));
        renderShipment(false);
        saveDebounced();
    }

    function renderShipmentHistory() {
        const container = document.getElementById('shipmentHistoryList');
        const dayAgo = Date.now() - 24 * 60 * 60 * 1000;
        SHIPMENT_HISTORY = SHIPMENT_HISTORY.filter(h => h.time >= dayAgo);
        localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
        if (SHIPMENT_HISTORY.length === 0) {
            container.innerHTML = '<div style="color: var(--text-dim); font-size: 12px;">История пуста</div>';
            return;
        }
        let html = '';
        SHIPMENT_HISTORY.slice(0, 50).forEach(h => {
            const t = new Date(h.time).toTimeString().slice(0,5);
            const parts = [];
            if (h.gab) parts.push(`+${h.gab} габ`);
            if (h.negab) parts.push(`+${h.negab} негаб`);
            if (h.ts) parts.push(`+${h.ts} ТС`);
            html += `<div class="history-item">
                <span class="h-time">${t}</span>
                <span class="h-text">${h.direction}: ${parts.join(', ')}</span>
            </div>`;
        });
        container.innerHTML = html;
    }

    function clearShipmentHistory() {
        if (!confirm('Очистить всю историю?')) return;
        SHIPMENT_HISTORY = [];
        localStorage.setItem('warehouseShipmentHistory', JSON.stringify(SHIPMENT_HISTORY));
